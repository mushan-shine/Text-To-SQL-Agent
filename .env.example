# Copy to .env (git-ignored). Databricks auth comes from ~/.databrickscfg (profile in config/phase0.yaml).
# MySQL = BEAVER's official engine, used as the reference oracle.
MYSQL_USER=root
MYSQL_PASSWORD=
# Optional: pin a SQL warehouse, otherwise the first (running) one is used.
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<id>

# LLM: Zhipu open platform (OpenAI-compatible). Create the key at https://open.bigmodel.cn → API Keys.
ZHIPUAI_API_KEY=
ZHIPU_MODEL=glm-4-flash
